---
import { getSite } from '../data/site';
const site = await getSite();
---
<footer class="relative mt-16 overflow-hidden border-t border-red-500/20 bg-black py-12 text-slate-400">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-red-500/60 to-transparent"></div>
  <div class="container">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 mb-10">
      <div><a href="/" class="text-lg font-bold text-white hover:text-red-400 transition-colors">{site.footer_brand}</a><p class="mt-3 max-w-md text-sm leading-6 text-slate-400">{site.footer_description}</p></div>
      {site.footer_groups.map(group => <nav aria-label={group.title}><h3 class="font-semibold text-white mb-3 text-sm">{group.title}</h3><ul class="space-y-2">{group.links.map(link => <li><a class="text-sm hover:text-red-400 transition-colors" href={link.href}>{link.label}</a></li>)}</ul></nav>)}
    </div>
    <div class="border-t border-white/10 pt-8 space-y-4"><p class="text-xs text-slate-500 leading-6">{site.footer_disclaimer}</p><p class="text-xs text-slate-600">© {new Date().getFullYear()} {site.footer_copyright}</p></div>
  </div>
</footer>
