---
const { slides, autoplay = true, interval = 6000 } = Astro.props;
---
<hero-carousel class="block relative bg-black text-white" role="region" aria-roledescription="輪播" aria-label="首頁精選" data-autoplay={String(autoplay)} data-interval={interval}>
  {slides.map((slide: any, index: number) => <section data-slide hidden={index !== 0} aria-hidden={index !== 0 ? 'true' : 'false'} role="group" aria-roledescription="投影片" aria-label={`${index + 1} / ${slides.length}`} class="hero-banner relative flex items-center justify-center overflow-hidden">
    {slide.media_type === 'video'
      ? <video class="absolute inset-0 h-full w-full object-cover opacity-70" data-src={slide.video} poster={slide.poster} muted loop playsinline preload="none" aria-label={slide.image_alt || slide.title || '背景影片'} />
      : <img class="absolute inset-0 h-full w-full object-cover opacity-70" src={slide.image} alt={slide.image_alt || ''} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />}
    <div class="absolute inset-0 bg-black/40" />
    <div class="container relative max-w-4xl text-center py-20">
      {slide.badge && <span class="badge">{slide.badge}</span>}
      {slide.title && <h2 class="mt-3 text-white text-3xl sm:text-5xl">{slide.title}</h2>}
      {slide.description && <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-300">{slide.description}</p>}
      {slide.button_href && <a class="button mt-8" href={slide.button_href}>{slide.button_label || slide.title}</a>}
    </div>
  </section>)}
  <div data-controls hidden class="absolute inset-x-0 bottom-5 flex items-center justify-center gap-3">
    {slides.length > 1 && <><button type="button" data-prev aria-label="上一張" class="carousel-control">←</button>{slides.map((_: any,index: number) => <button type="button" data-dot={index} aria-label={`切換至第 ${index + 1} 張`} aria-pressed={index === 0 ? 'true' : 'false'} class="carousel-control">{index + 1}</button>)}<button type="button" data-next aria-label="下一張" class="carousel-control">→</button></>}
    {(slides.length > 1 || slides.some((slide: any) => slide.media_type === 'video')) && <button type="button" data-pause class="carousel-control">暫停播放</button>}
  </div>
</hero-carousel>
<style>
  [hidden] { display: none !important; }
  .carousel-control { min-width: 2.5rem; min-height: 2.5rem; padding: .4rem .75rem; border: 1px solid #ffffff66; border-radius: 999px; background: #000a; color: white; }
  .carousel-control[aria-pressed="true"] { background: #b91c1c; }
  .carousel-control:focus-visible { outline: 2px solid white; outline-offset: 3px; }
</style>
<script>
  class HeroCarousel extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      const pause = this.querySelector<HTMLButtonElement>('[data-pause]');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const abort = new AbortController();
      let index = 0;
      let paused = this.dataset.autoplay !== 'true' || motion.matches;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let hovered = false;
      let focused = false;
      const update = () => {
        clearTimeout(timer);
        const stopped = paused || hovered || focused || document.hidden;
        slides.forEach((slide, i) => {
          slide.hidden = i !== index;
          slide.setAttribute('aria-hidden', String(i !== index));
          const video = slide.querySelector('video');
          if (video) {
            if (i === index && !video.src) video.src = video.dataset.src!;
            if (i === index && !stopped) { video.muted = true; void video.play().catch(() => {}); }
            else video.pause();
          }
        });
        dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === index)));
        if (pause) pause.textContent = paused ? '播放輪播' : '暫停播放';
        if (!stopped && slides.length > 1) timer = setTimeout(() => { index = (index + 1) % slides.length; update(); }, Number(this.dataset.interval) || 6000);
      };
      const move = (step: number) => { index = (index + step + slides.length) % slides.length; update(); };
      const options = { signal: abort.signal };
      this.querySelector('[data-prev]')?.addEventListener('click', () => move(-1), options);
      this.querySelector('[data-next]')?.addEventListener('click', () => move(1), options);
      dots.forEach((dot, i) => dot.addEventListener('click', () => { index = i; update(); }, options));
      pause?.addEventListener('click', () => { paused = !paused; update(); }, options);
      this.addEventListener('mouseenter', () => { hovered = true; update(); }, options);
      this.addEventListener('mouseleave', () => { hovered = false; update(); }, options);
      this.addEventListener('focusin', () => { focused = true; update(); }, options);
      this.addEventListener('focusout', (event) => { if (!this.contains(event.relatedTarget as Node)) { focused = false; update(); } }, options);
      this.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1); } }, options);
      document.addEventListener('visibilitychange', update, options);
      motion.addEventListener('change', () => { if (motion.matches) paused = true; update(); }, options);
      this.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
      update();
      this.cleanup = () => { abort.abort(); clearTimeout(timer); slides.forEach(slide => slide.querySelector('video')?.pause()); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('hero-carousel')) customElements.define('hero-carousel', HeroCarousel);
</script>
