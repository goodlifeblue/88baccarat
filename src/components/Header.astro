---
import { navigation } from '../data/navigation';
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-black/70 backdrop-blur-xl">
  <div class="container flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="text-lg font-extrabold text-white" aria-label="百家樂攻略誌首頁">♠ 百家樂攻略誌</a>
    <nav aria-label="主要導覽" class="hidden md:block"><ul class="flex items-center gap-5">{navigation.map((item) => <li><a class="text-sm font-medium text-slate-300 hover:text-red-400" href={item.href}>{item.label}</a></li>)}</ul></nav>
    <a class="rounded-full border border-red-500/40 bg-white/5 px-3 py-2 text-sm font-semibold text-white backdrop-blur-md transition-colors hover:bg-red-600/20 md:hidden" href="#site-navigation">選單</a>
  </div>
  <nav id="site-navigation" aria-label="行動版導覽" class="border-t border-white/10 md:hidden"><ul class="container flex gap-4 overflow-x-auto py-3 whitespace-nowrap">{navigation.map((item) => <li><a class="text-sm font-medium text-slate-300 hover:text-red-400" href={item.href}>{item.label}</a></li>)}</ul></nav>
</header>
