---
const { category } = Astro.props;
---
<article class="card p-5"><span class="text-2xl" aria-hidden="true">{category.icon}</span><h2 class="mt-3 text-xl"><a href={category.href} class="hover:text-brand-600">{category.title}</a></h2><p class="mt-2 text-sm leading-6 text-slate-600">{category.description}</p></article>
