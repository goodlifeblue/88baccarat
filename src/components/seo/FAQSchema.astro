---
import JsonLd from './JsonLd.astro'; const { items } = Astro.props;
const data = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:items.map((item: any) => ({ '@type':'Question', name:item.question, acceptedAnswer:{ '@type':'Answer', text:item.answer } })) };
---
{items.length > 0 && <JsonLd {data} />}
