---
import { getSite } from '../data/site';
const site = await getSite();
interface Item { label: string; href?: string }
const { items } = Astro.props as { items: Item[] };
---
<nav aria-label="麵包屑" class="mb-6 text-sm text-slate-400"><ol class="flex flex-wrap gap-2"><li><a href="/" class="hover:text-red-400">{site.labels.home}</a></li>{items.map((item) => <><li aria-hidden="true">/</li><li>{item.href ? <a href={item.href} class="hover:text-red-400">{item.label}</a> : <span aria-current="page">{item.label}</span>}</li></>)}</ol></nav>
