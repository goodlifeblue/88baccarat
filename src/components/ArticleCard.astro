---
const { article, collection } = Astro.props as { article: any; collection: string };
const href = `/${collection}/${article.id.replace(/\.mdx?$/, '')}/`;
---
<article class="card flex h-full flex-col p-5"><p class="text-sm font-semibold text-brand-600">{collection}</p><h3 class="mt-2"><a href={href} class="hover:text-brand-600">{article.data.title}</a></h3><p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{article.data.description}</p><a href={href} class="mt-5 text-sm font-semibold text-brand-600">閱讀文章 <span aria-hidden="true">→</span></a></article>
