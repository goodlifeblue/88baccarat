---
import Breadcrumb from "./Breadcrumb.astro";
import { getSite } from '../data/site';
const site = await getSite();

const {
  title,
  description,
  breadcrumbs = [],
  image = site.inner_banner,
} = Astro.props as {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  image?: string;
};
---

<section
  class="relative flex min-h-[260px] items-center overflow-hidden bg-black text-white sm:min-h-[300px]"
>
  <img
    class="absolute inset-0 h-full w-full object-cover opacity-55"
    src={image}
    alt=""
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-black/45"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_20%_100%,rgba(220,38,38,0.35),transparent)]"
  >
  </div>
  <div class="container relative" data-animate>
    <div
      class="[&_a]:text-slate-300 [&_a:hover]:text-red-400 [&_nav]:text-slate-400"
    >
      <Breadcrumb items={breadcrumbs} />
    </div>
    <p class="text-sm font-semibold tracking-[0.2em] text-red-400">
      {site.name}
    </p>
    <h1 class="mt-3 max-w-4xl text-white">{title}</h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">
          {description}
        </p>
      )
    }
  </div>
</section>
