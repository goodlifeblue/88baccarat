---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from './InnerBanner.astro';
import BreadcrumbSchema from './seo/BreadcrumbSchema.astro';
import FAQSchema from './seo/FAQSchema.astro';
import FAQ from './FAQ.astro';
import ArticleList from './ArticleList.astro';
import PageSections from './PageSections.astro';
import HeroCarousel from './HeroCarousel.astro';
import { getCollection } from 'astro:content';
import { renderPageMarkdown } from '../lib/page-markdown.mjs';
const { page } = Astro.props;
const breadcrumbs = page.path === '/' ? [] : [{ label: page.breadcrumb_label || page.title }];
const home = page.page_type === 'custom_page' && page.custom_template === 'home';
const names = ['baccarat', 'strategy', 'guide', 'tips', 'comparison'] as const;
const articles = page.page_type === 'article_list' && page.article_list_enabled !== false
  ? (await Promise.all(names.filter(name => page.article_category === 'all' || page.article_category === name).map(name => getCollection(name)))).flat().sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()) : [];
const faqs = page.faq_enabled === false ? [] : page.page_type === 'custom_page' && page.custom_template === 'faq'
  ? [...(await Promise.all([...names, 'faq' as const].map(name => getCollection(name)))).flat().flatMap(entry => entry.data.faq), ...page.faq] : page.faq;
const html = page.content_enabled === false ? '' : await renderPageMarkdown(page.content);
---
<BaseLayout title={page.title} description={page.seo_description || page.description} seoTitle={page.seo_title} image={page.hero_image}>
  {home ? <><h1 class={page.hero_slides.length ? 'sr-only' : 'container pt-12'}>{page.title}</h1>{page.hero_slides.length > 0 && <HeroCarousel slides={page.hero_slides} autoplay={page.hero_autoplay !== false} interval={page.hero_interval} />}</> : <InnerBanner title={page.title} description={page.description} {breadcrumbs} image={page.hero_image} />}
  <div class={home ? 'container py-12 sm:py-16' : 'container py-8 sm:py-12'}>
    {page.path !== '/' && <BreadcrumbSchema items={breadcrumbs} />}
    {html && <div class="prose" set:html={html} />}
    {page.page_type === 'article_list' && page.article_list_enabled !== false && <div class="mt-6"><ArticleList {articles} collection={page.article_category} /></div>}
    <PageSections sections={page.sections} />
    {faqs.length > 0 && <div class="mt-14"><FAQ items={faqs} /><FAQSchema items={faqs} /></div>}
  </div>
</BaseLayout>
