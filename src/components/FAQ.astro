---
import { getSite } from '../data/site';
const site = await getSite();
const { items } = Astro.props as { items: { question: string; answer: string }[] };
---
<section aria-labelledby="faq-title"><h2 id="faq-title" class="mb-6">{site.labels.faq}</h2><div class="space-y-3">{items.map((item) => <details class="card p-5"><summary class="cursor-pointer font-semibold text-white marker:text-red-500">{item.question}</summary><p class="mt-3 leading-7 text-slate-400">{item.answer}</p></details>)}</div></section>
