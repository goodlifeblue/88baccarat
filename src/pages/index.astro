---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ArticleList from "../components/ArticleList.astro";
import FAQ from "../components/FAQ.astro";
import { categories } from "../data/categories";
import { getCollection } from "astro:content";
const collections = [
  "baccarat",
  "strategy",
  "guide",
  "tips",
  "comparison",
] as const;
const all = (
  await Promise.all(
    collections.map(async (collection) =>
      (await getCollection(collection)).map((article) => ({
        article,
        collection,
      })),
    ),
  )
)
  .flat()
  .sort(
    (a, b) =>
      b.article.data.publishedAt.valueOf() -
      a.article.data.publishedAt.valueOf(),
  );
const popular = all.filter((x) => x.article.data.featured).slice(0, 3);
const latest = all.slice(0, 3);
const homeFaq = [
  {
    question: "百家樂新手應先學什麼？",
    answer: "先理解點數計算、莊閒與和局三種下注選項，以及第三張牌規則。",
  },
  {
    question: "百家樂策略能保證獲利嗎？",
    answer: "不能。策略的作用是協助管理風險、設定界線並避免非理性追注。",
  },
  {
    question: "百家樂新手應先學什麼？",
    answer: "先理解點數計算、莊閒與和局三種下注選項，以及第三張牌規則。",
  },
  {
    question: "百家樂策略能保證獲利嗎？",
    answer: "不能。策略的作用是協助管理風險、設定界線並避免非理性追注。",
  },
];
---

<BaseLayout
  title="百家樂玩法、策略與新手指南"
  description="系統化整理百家樂玩法、規則、策略、比數法與資金管理。"
>
  <section class="relative overflow-hidden bg-black py-24 text-white sm:py-36">
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-70"
      src="/poker.mp4"
      autoplay
      muted
      loop
      playsinline></video><div class="absolute inset-0 bg-black/5"></div><div
      class="pointer-events-none absolute inset-0 bg-black,radial-gradient(ellipse_50%_40%_at_100%_100%,rgba(220,38,38,0.2),transparent)]"
    >
    </div><div class="container relative max-w-4xl">
      <p class="font-semibold tracking-[0.2em] text-red-400" data-animate>
        SEO 百家樂內容網站
      </p><h1 class="mt-3 text-white" data-animate data-delay="0.1">
        從規則到策略，讀懂百家樂的每一步
      </h1><p
        class="mt-5 max-w-2xl text-lg leading-8 text-slate-300"
        data-animate
        data-delay="0.2"
      >
        以清晰、負責任的內容整理玩法、機率與紀律，幫助你建立自己的遊戲知識架構。
      </p><a class="button mt-8" href="/guide/" data-animate data-delay="0.3"
        >從新手指南開始</a
      >
    </div>
  </section>
  <div class="container py-12 sm:py-16">
    <section aria-labelledby="rules" class="card px-5 py-10 sm:px-10 sm:py-14">
      <div class="text-center">
        <h2 id="rules" class="text-3xl sm:text-5xl">百家樂玩法規則</h2><div
          class="mx-auto mt-4 h-1 w-16 rounded-full bg-red-500 shadow-[0_0_12px_2px_rgba(220,38,38,0.6)]"
        >
        </div>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article class="card p-6 sm:p-9">
          <h3>基本規則</h3><ul
            class="mt-7 space-y-4 leading-7 text-slate-300 marker:text-red-500"
          >
            <li>
              <strong class="text-white">遊戲目標：</strong
              >預測莊家或閒家哪一方的牌點數最接近 9 點
            </li><li>
              <strong class="text-white">牌值計算：</strong
              >A=1，2–9=點數，10/J/Q/K=0
            </li><li>
              <strong class="text-white">初始發牌：</strong>莊家與閒家各發 2
              張牌
            </li><li>
              <strong class="text-white">天牌：</strong>初始 8 點或 9
              點，不需補牌
            </li>
          </ul>
        </article>
        <article class="card p-6 sm:p-9">
          <h3>賠率說明</h3><ul
            class="mt-7 space-y-4 leading-7 text-slate-300 marker:text-red-500"
          >
            <li>
              <strong class="text-white">閒家贏：</strong>1 賠 1（下注 100，贏
              100）
            </li><li>
              <strong class="text-white">莊家贏：</strong>1 賠 0.95（需扣 5%
              佣金）
            </li><li>
              <strong class="text-white">和局：</strong>1 賠 8（雙方點數相同）
            </li><li>
              <strong class="text-white">對子：</strong>1 賠 11（同點數對子）
            </li>
          </ul>
        </article>
      </div>
      <article class="card mt-6 p-6 sm:p-9">
        <h3>補牌規則</h3><div class="mt-7 grid gap-8 lg:grid-cols-2">
          <div>
            <h4 class="font-bold text-white">閒家補牌規則</h4><ul
              class="mt-4 space-y-2 leading-7 text-slate-300 marker:text-red-500"
            >
              <li>點數 0–5：必須補牌</li><li>點數 6–7：停牌</li><li>
                點數 8–9：天牌，不補牌
              </li>
            </ul>
          </div><div>
            <h4 class="font-bold text-white">莊家補牌規則</h4><ul
              class="mt-4 space-y-2 leading-7 text-slate-300 marker:text-red-500"
            >
              <li>點數 0–2：必須補牌</li><li>
                點數 3–6：根據閒家第三張牌決定
              </li><li>點數 7：停牌</li><li>點數 8–9：天牌，不補牌</li>
            </ul>
          </div>
        </div>
      </article>
      <p class="mt-6 text-sm leading-6 text-slate-500">
        實際補牌與賠率依各牌桌規則為準。
      </p>
    </section>
    <section class="mt-14" aria-labelledby="categories">
      <h2 id="categories">百家樂主題分類</h2><div
        class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >
        {categories.map((category) => <CategoryCard {category} />)}
      </div>
    </section><section class="mt-14" aria-labelledby="popular">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="popular">熱門攻略</h2><a
          href="/baccarat/"
          class="text-sm font-semibold text-red-400 hover:text-red-300"
          >探索百家樂文章 →</a
        >
      </div><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          popular.map(({ article, collection }) => (
            <ArticleCard article={article} collection={collection} />
          ))
        }
      </div>
    </section><section class="mt-14" aria-labelledby="strategy">
      <h2 id="strategy">策略分類</h2><p class="mt-2 text-slate-400">
        從下注紀律與資金管理建立可持續的遊戲觀念。
      </p><div class="mt-6">
        <ArticleList
          articles={(await getCollection("strategy")).slice(0, 3)}
          collection="strategy"
        />
      </div>
    </section><section class="mt-14" aria-labelledby="latest">
      <h2 id="latest">最新文章</h2><div
        class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          latest.map(({ article, collection }) => (
            <ArticleCard article={article} collection={collection} />
          ))
        }
      </div>
    </section><div class="mt-14 max-w-6xl"><FAQ items={homeFaq} /></div>
  </div>
</BaseLayout>
