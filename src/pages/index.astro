---
import BaseLayout from '../layouts/BaseLayout.astro'; import CategoryCard from '../components/CategoryCard.astro'; import ArticleList from '../components/ArticleList.astro'; import FAQ from '../components/FAQ.astro'; import { categories } from '../data/categories'; import { getCollection } from 'astro:content';
const collections = ['baccarat','strategy','guide','tips','comparison'] as const;
const all = (await Promise.all(collections.map(async (collection) => (await getCollection(collection)).map((article) => ({article,collection}))))).flat().sort((a,b) => b.article.data.publishedAt.valueOf()-a.article.data.publishedAt.valueOf());
const popular = all.filter((x) => x.article.data.featured).slice(0,3); const latest = all.slice(0,3);
const homeFaq = [{question:'百家樂新手應先學什麼？',answer:'先理解點數計算、莊閒與和局三種下注選項，以及第三張牌規則。'},{question:'百家樂策略能保證獲利嗎？',answer:'不能。策略的作用是協助管理風險、設定界線並避免非理性追注。'}];
---
<BaseLayout title="百家樂玩法、策略與新手指南" description="系統化整理百家樂玩法、規則、策略、比數法與資金管理。"><section class="relative overflow-hidden bg-ink py-24 text-white sm:py-36"><video class="absolute inset-0 h-full w-full object-cover" src="/index.mp4" autoplay muted loop playsinline></video><div class="absolute inset-0 bg-ink/70"></div><div class="container relative max-w-4xl"><p class="font-semibold text-red-300">SEO 百家樂內容網站</p><h1 class="mt-3 text-white">從規則到策略，讀懂百家樂的每一步</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">以清晰、負責任的內容整理玩法、機率與紀律，幫助你建立自己的遊戲知識架構。</p><a class="button mt-8" href="/guide/">從新手指南開始</a></div></section><div class="container py-12 sm:py-16"><section aria-labelledby="categories"><h2 id="categories">百家樂主題分類</h2><div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{categories.map((category) => <CategoryCard {category} />)}</div></section><section class="mt-14" aria-labelledby="popular"><div class="flex items-baseline justify-between gap-4"><h2 id="popular">熱門攻略</h2><a href="/baccarat/" class="text-sm font-semibold text-brand-600">探索百家樂文章 →</a></div><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{popular.map(({article,collection}) => <ArticleList articles={[article]} collection={collection} />)}</div></section><section class="mt-14" aria-labelledby="strategy"><h2 id="strategy">策略分類</h2><p class="mt-2 text-slate-600">從下注紀律與資金管理建立可持續的遊戲觀念。</p><div class="mt-6"><ArticleList articles={(await getCollection('strategy')).slice(0,3)} collection="strategy" /></div></section><section class="mt-14" aria-labelledby="latest"><h2 id="latest">最新文章</h2><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{latest.map(({article,collection}) => <ArticleList articles={[article]} collection={collection} />)}</div></section><div class="mt-14 max-w-3xl"><FAQ items={homeFaq} /></div></div></BaseLayout>
