---
import PageLayout from "../../layouts/PageLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";
const articles = await getCollection("tips");
---

<PageLayout
    title="百家樂技巧"
    description="理解比數法與路單分析，培養更清楚的判讀習慣。"
    breadcrumbs={[{ label: "技巧" }]}
    ><ArticleList {articles} collection="tips" /></PageLayout
>
