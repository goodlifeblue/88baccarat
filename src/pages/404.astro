---
import { getSite } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
const site = await getSite();
---
<BaseLayout noindex={true} canonical={new URL('/404.html', site.url).href} title={site.not_found_title} description={site.not_found_description}><section class="container py-20 text-center"><h1>{site.not_found_title}</h1><p class="mt-4 text-slate-400">{site.not_found_content}</p><a href="/" class="button mt-6">{site.not_found_button}</a></section></BaseLayout>
