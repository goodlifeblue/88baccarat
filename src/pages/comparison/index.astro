---
import PageLayout from "../../layouts/PageLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";
const articles = await getCollection("comparison");
---

<PageLayout
    title="百家樂比較"
    description="比較不同百家樂玩法與下注選項的規則差異。"
    breadcrumbs={[{ label: "比較" }]}
    ><ArticleList {articles} collection="comparison" /></PageLayout
>
