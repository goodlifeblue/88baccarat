---
import { getCollection } from 'astro:content';
import ManagedArticle from '../../components/ManagedArticle.astro';
export async function getStaticPaths() {
  return (await getCollection('comparison')).map(article => ({
    params: { slug: article.id.replace(/\.mdx?$/, '') }, props: { article },
  }));
}
---
<ManagedArticle collection="comparison" slug={Astro.params.slug} entry={Astro.props.article} />
