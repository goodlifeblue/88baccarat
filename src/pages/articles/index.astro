---
import PageLayout from "../../layouts/PageLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";

// 收集所有分類的文章作為知識文章
const collections = [
  "baccarat",
  "strategy",
  "guide",
  "tips",
  "comparison",
] as const;

const allArticles = (
  await Promise.all(
    collections.map(async (collection) =>
      (await getCollection(collection)).map((article) => ({
        article,
        collection,
      })),
    ),
  )
)
  .flat()
  .sort(
    (a, b) =>
      b.article.data.publishedAt.valueOf() -
      a.article.data.publishedAt.valueOf(),
  );
---

<PageLayout
  title="百家樂知識文章"
  description="百家樂知識庫，包含規則講解、策略分析、技巧分享、牌路理論等系統化內容。"
  breadcrumbs={[{ label: "百家樂知識" }]}
>
  <div class="prose">
    <h2>知識文章分類</h2>
    <p>系統化整理百家樂相關知識，從基礎規則到進階分析方法。</p>
  </div>
  
  <div class="mt-10">
    <ArticleList articles={allArticles.map(x => x.article)} collection="articles" />
  </div>
</PageLayout>
