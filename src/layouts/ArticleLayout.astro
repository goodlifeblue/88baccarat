---
import BaseLayout from "./BaseLayout.astro";
import BreadcrumbSchema from "../components/seo/BreadcrumbSchema.astro";
import ArticleSchema from "../components/seo/ArticleSchema.astro";
import FAQ from "../components/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import TableOfContents from "../components/TableOfContents.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import { getSite } from "../data/site";
const site = await getSite();
import { getCollection } from "astro:content";
import InnerBanner from "../components/InnerBanner.astro";
const labels = Object.fromEntries(site.categories.map(category => [category.key, category.title]));
const { article, collection, headings, related, liveRelated = false } = Astro.props as {
    article: any;
    collection: keyof typeof labels;
    headings: any[];
    related: any[];
    liveRelated?: boolean;
};
const categoryLabel = labels[collection];
const slug = article.id.replace(/\.mdx?$/, "");
const breadcrumbs = [
    { label: categoryLabel, href: `/${collection}/` },
    { label: article.data.title },
];
const url = new URL(`/${collection}/${slug}/`, site.url).toString();
const selected = liveRelated ? [] : article.data.relatedArticles || [];
const all = selected.length ? (await Promise.all(
    (['baccarat', 'strategy', 'guide', 'tips', 'comparison'] as const).map((name) => getCollection(name))
)).flat() : [];
const relatedEntries = selected.length
    ? selected.map((id: string) => all.find((entry) => entry.data.cmsId === id))
        .filter((entry: any) => entry && !(entry.collection === collection && entry.id === article.id))
    : related;
---

<BaseLayout
    title={article.data.title}
    description={article.data.seoDescription || article.data.description}
    seoTitle={article.data.seoTitle}
    canonical={url}
    noindex={article.data.noindex}
    image={article.data.ogImage || article.data.image}
    type="article"
    ><InnerBanner
        title={article.data.title}
        description={article.data.description}
        {breadcrumbs}
    /><div class="container py-8 sm:py-12">
        <BreadcrumbSchema items={breadcrumbs} /><ArticleSchema
            {article}
            {url}
        /><article class="mx-auto max-w-3xl">
            <header>
                <p class="text-sm font-semibold text-red-400">
                    {categoryLabel}
                </p><p class="mt-3 text-sm text-slate-500">
                    <time datetime={article.data.publishedAt.toISOString()}
                        >{
                            article.data.publishedAt.toLocaleDateString("zh-TW")
                        }</time
                    > ・ {article.data.author}
                    {article.data.updatedAt && <span> ・ {site.labels.updated}<time datetime={article.data.updatedAt.toISOString()}>{article.data.updatedAt.toLocaleDateString("zh-TW")}</time></span>}
                </p>
            </header><TableOfContents {headings} /><div class="prose">
                <slot />
            </div>{article.data.faq.length > 0 && <FAQ items={article.data.faq} />}<FAQSchema
                items={article.data.faq}
            /><RelatedArticles articles={relatedEntries} {collection} />
        </article>
    </div></BaseLayout
>
