---
import BaseLayout from './BaseLayout.astro'; import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'; import InnerBanner from '../components/InnerBanner.astro';
const { title, description, breadcrumbs = [] } = Astro.props;
---
<BaseLayout {title} {description}><InnerBanner {title} {description} {breadcrumbs} /><div class="container py-8 sm:py-12"><BreadcrumbSchema items={breadcrumbs} /><slot /></div></BaseLayout>
