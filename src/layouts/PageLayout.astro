---
import BaseLayout from './BaseLayout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
const { title, description, breadcrumbs = [] } = Astro.props;
---
<BaseLayout {title} {description}><div class="container py-8 sm:py-12"><Breadcrumb items={breadcrumbs} /><BreadcrumbSchema items={breadcrumbs} /><header class="mb-10 max-w-3xl"><h1>{title}</h1><p class="mt-4 text-lg leading-8 text-slate-600">{description}</p></header><slot /></div></BaseLayout>
