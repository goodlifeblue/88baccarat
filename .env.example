APP_ENV=local
# Staging/Production use GitHub Environment variables; see docs/HANDOVER.md
# Directus 环境变量示例
# 复制本文件为 .env 或 .env.local 并填写实际值

# ===== Directus 配置 =====
DIRECTUS_URL=http://localhost:8055
DIRECTUS_API_TOKEN=your_api_token_here
DIRECTUS_KEY=your-secret-key-change-in-production
DIRECTUS_SECRET=your-secret-change-in-production
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin123

# ===== 数据库配置 =====
# SQLite（开发环境）
DB_CLIENT=sqlite3
DB_FILENAME=./directus/database.sqlite

# PostgreSQL（生产环境）
# DB_CLIENT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=directus
# DB_PASSWORD=your_db_password
# DB_NAME=directus

# ===== 网站配置 =====
SITE_URL=http://localhost:3000
PUBLIC_URL=http://localhost:8055

# ===== CORS 设置 =====
CORS_ENABLED=true
CORS_ORIGIN=*

# ===== 上传文件设置 =====
UPLOAD_DIR=./directus/uploads
STORAGE_LOCATIONS_LOCAL_DRIVER=local
STORAGE_LOCATIONS_LOCAL_ROOT=./directus/uploads

# ===== 邮件配置（可选）=====
# MAIL_DRIVER=smtp
# MAIL_FROM=noreply@example.com
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=your_email@example.com
# MAIL_PASSWORD=your_password

# local 保留 Markdown；完成資料匯入與權限設定後改成 directus
CONTENT_SOURCE=local
# 僅用於 directus:setup / directus:import，不可放進 PUBLIC_ 變數
DIRECTUS_ADMIN_TOKEN=

# 搬遷時填入舊 Directus 基底網址，逗號分隔
DIRECTUS_LEGACY_URLS=
